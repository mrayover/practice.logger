# Auto detect text files and perform LF normalization
* text=auto

# Shell runners must also execute directly from a Windows checkout.
*.sh text eol=lf
gradlew text eol=lf
*.bat text eol=crlf
*.ttf binary
*.jar binary

# Preserve PDF fixture bytes and cross-reference offsets on every checkout.
*.pdf binary

# Portable source and operational records. Schema exports retain generator bytes.
*.kt text eol=lf
*.kts text eol=lf
*.md text eol=lf
*.yml text eol=lf
