<resources>
    <style name="Theme.PracticeLogger" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/practice_light_background</item>
        <item name="android:colorBackground">@color/practice_light_background</item>
        <item name="android:fontFamily">@font/lato</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/practice_light_accent</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="Theme.PracticeLogger.Light" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/practice_light_background</item>
        <item name="android:colorBackground">@color/practice_light_background</item>
        <item name="android:fontFamily">@font/lato</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/practice_light_accent</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="Theme.PracticeLogger.Dark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/practice_dark_background</item>
        <item name="android:colorBackground">@color/practice_dark_background</item>
        <item name="android:fontFamily">@font/lato</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/practice_dark_accent</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="Theme.PracticeLogger.Smooth" parent="Theme.PracticeLogger.Dark">
        <item name="android:windowBackground">@color/practice_smooth_background</item>
        <item name="android:colorBackground">@color/practice_smooth_background</item>
        <item name="android:colorAccent">@color/practice_smooth_accent</item>
    </style>
    <style name="Theme.PracticeLogger.Sunny" parent="Theme.PracticeLogger.Light">
        <item name="android:windowBackground">@color/practice_sunny_background</item>
        <item name="android:colorBackground">@color/practice_sunny_background</item>
        <item name="android:colorAccent">@color/practice_sunny_accent</item>
    </style>
    <style name="Theme.PracticeLogger.Orchid" parent="Theme.PracticeLogger.Dark">
        <item name="android:windowBackground">@color/practice_orchid_background</item>
        <item name="android:colorBackground">@color/practice_orchid_background</item>
        <item name="android:colorAccent">@color/practice_orchid_accent</item>
    </style>
</resources>
